# ============================================================================
# Copy to .env.local and fill in. Every block is optional — the app degrades
# gracefully instead of crashing:
#
#   no Supabase keys  -> demo mode (in-memory data, account picker) in development;
#                        a production build refuses to sign anyone in
#   no GST details    -> invoices render stamped DRAFT
#
# Check /admin to see which integrations are live.
# ============================================================================

# ---------------------------------------------------------------- Supabase --
# Project Settings -> API. The anon key is public by design; the service role key
# must never be exposed to the browser (no NEXT_PUBLIC_ prefix, never logged).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Auth --
# Sign-in requires BOTH this domain AND an active row in allowed_users.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=spintly.com

# Bootstrap admin access on a fresh database, before any allowed_users row has
# is_admin = true. Comma-separated. Clear this once a real admin row exists.
ADMIN_EMAILS=

# Used to build the magic-link redirect. Must match the deployed origin exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the demo-mode session cookie. Irrelevant once Supabase is configured.
DEMO_SESSION_SECRET=

# ------------------------------------------------------- GST invoice details --
# Leave blank until you have the real values. Fake GSTINs on a tax invoice are a
# statutory problem, so unconfigured invoices are watermarked DRAFT rather than
# silently filled with plausible-looking numbers.
# Address lines are separated by a pipe: "Unit 4, Some Road|Panaji, Goa 403001"
SELLER_NAME=FunKustoms
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_BANK_DETAILS=

BUYER_NAME=RMJV
BUYER_ADDRESS=
BUYER_GSTIN=
BUYER_STATE=
BUYER_STATE_CODE=

# --------------------------------------------- Project management app sync --
# Service account for the finquest-6faed Firebase project. Confirming an order creates a
# task under "Spintly Orders" there, and its stage drives the order's status here.
# Point at the key file (keep it outside the repo) or paste the JSON into FIREBASE_SERVICE_ACCOUNT.
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT=

# ---------------------------------------------------------------- Catalog --
# Dev only, when Supabase isn't configured: folder containing Products/ (defaults to the app's parent).
# With Supabase, catalog files are served from the `catalog` bucket.
CATALOG_ROOT=

# Staging smoke tests only: lets a production build run on demo data. Never set in production.
ALLOW_DEMO_MODE=

# ------------------------------------------------------------ SWIPE invoices --
# GST invoices are created on SWIPE when an order reaches Completed in the project
# management app. Key: SWIPE dashboard -> API Integration.
SWIPE_API_KEY=
# Optional overrides (defaults: RMJV Innovations Private Limited, its GSTIN)
SWIPE_CUSTOMER_NAME=
SWIPE_CUSTOMER_GSTIN=

# Lets a scheduler hit GET /api/cron/sync (Authorization: Bearer <this>) every few minutes,
# so stage changes and invoices happen without anyone opening the portal.
CRON_SECRET=

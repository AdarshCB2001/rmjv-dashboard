# ============================================================================
# Copy to .env.local and fill in. Every block is optional — the app degrades
# gracefully instead of crashing:
#
#   no Supabase keys  -> demo mode (seeded in-memory data, account-picker sign-in)
#   no Razorpay keys  -> payments are simulated
#   no GST details    -> invoices render stamped DRAFT
#   no chat keys      -> the chat widget is hidden
#
# Check /admin to see which integrations are live.
# ============================================================================

# ---------------------------------------------------------------- Supabase --
# Project Settings -> API. The anon key is public by design; the service role key
# must never be exposed to the browser (no NEXT_PUBLIC_ prefix, never logged).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------- Auth --
# Sign-in requires BOTH this domain AND an active row in allowed_users.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAIN=spintly.com

# Bootstrap admin access on a fresh database, before any allowed_users row has
# is_admin = true. Comma-separated. Clear this once a real admin row exists.
ADMIN_EMAILS=

# Used to build the magic-link redirect. Must match the deployed origin exactly.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the demo-mode session cookie. Irrelevant once Supabase is configured.
DEMO_SESSION_SECRET=

# --------------------------------------------------------------- Razorpay --
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same value as RAZORPAY_KEY_ID. Only needed if you prefer the client to read the
# key id directly; the create-payment endpoint returns it either way.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay dashboard -> Webhooks. Add POST {SITE_URL}/api/razorpay-webhook for the
# payment.captured event and paste the secret here. Without it a payment confirmed
# after the customer closes the tab won't be recorded.
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------- GST invoice details --
# Leave blank until you have the real values. Fake GSTINs on a tax invoice are a
# statutory problem, so unconfigured invoices are watermarked DRAFT rather than
# silently filled with plausible-looking numbers.
# Address lines are separated by a pipe: "Unit 4, Some Road|Panaji, Goa 403001"
SELLER_NAME=FunKustoms
SELLER_ADDRESS=
SELLER_GSTIN=
SELLER_STATE=
SELLER_STATE_CODE=
SELLER_EMAIL=
SELLER_PHONE=
SELLER_BANK_DETAILS=

BUYER_NAME=RMJV
BUYER_ADDRESS=
BUYER_GSTIN=
BUYER_STATE=
BUYER_STATE_CODE=

# ------------------------------------------------------------------- Chat --
# Set one or the other. Crisp wins if both are present.
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_TAWK_PROPERTY_ID=
NEXT_PUBLIC_TAWK_WIDGET_ID=
